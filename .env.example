# ==============================================================================
# Lumora + Cypher Swift Partner Network — Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_NAME="Lumora + Cypher Swift Partner Network"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1

# Database Configuration (PostgreSQL 16+)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/lumora_cypher_db?schema=public"

# Redis Configuration (BullMQ & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_SECRET="lumora_cypher_super_secret_jwt_key_2026_dev_only_change_in_prod"
JWT_EXPIRATION="15m"
JWT_REFRESH_SECRET="lumora_cypher_super_secret_refresh_jwt_key_2026_dev_only"
JWT_REFRESH_EXPIRATION="7d"

# Security & CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:8081,exp://localhost:8081"
BCRYPT_SALT_ROUNDS=10

# Service Adapters (development vs production)
# Values: console | sms
OTP_ADAPTER=console
# Values: console | smtp
EMAIL_ADAPTER=console
# Values: console | fcm
PUSH_ADAPTER=console
# Values: local | s3 | r2
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR="./storage/uploads"

# Transactional Email (Optional for production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=secretpassword
SMTP_FROM="Lumora & Cypher Swift <no-reply@cypherswift.com>"

# Cloudflare R2 / S3-compatible Object Storage (Optional for production)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=lumora-partner-network
R2_PUBLIC_URL=

# Firebase Cloud Messaging (Optional for production)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# Commercial defaults (awaiting formal business confirmation)
SHARED_DIAGNOSTIC_PRICE_PAISE=3700000
CURRENCY="INR"
